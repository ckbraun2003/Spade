# SpadeVersionGen.cmake -- writes spade_version.hpp (L73a). Run as a script by the spade_version_header target on EVERY build:
#   cmake -DSOURCE_DIR=<repo> -DVERSION_FILE=<packaging/common/VERSION> -DOUT=<header> -P SpadeVersionGen.cmake
#
# The editor's product version is the first word of packaging/common/VERSION (0.MINOR.PATCH); the header adds the git SHA (7 hex)
# and whether tracked files differ from HEAD, so --version and Help > About name the exact build: "0.1.0+ab12cd3", with "-dirty"
# appended when the tree is not clean. project(Spade VERSION ...) is the LIBRARY's version and is not this.
#
# The file is written ONLY when its text changes, so a build whose version and SHA did not move recompiles nothing that includes
# it. Generating at build time rather than at configure time is what keeps the SHA from going stale after a commit.

if(NOT SOURCE_DIR OR NOT VERSION_FILE OR NOT OUT)
    message(FATAL_ERROR "SpadeVersionGen.cmake: -DSOURCE_DIR, -DVERSION_FILE and -DOUT are required")
endif()

file(READ "${VERSION_FILE}" _version_text)
string(REGEX MATCH "^[ \t\r\n]*([0-9]+\\.[0-9]+\\.[0-9]+)" _matched "${_version_text}")
if(NOT _matched)
    message(FATAL_ERROR "SpadeVersionGen.cmake: ${VERSION_FILE} must begin with MAJOR.MINOR.PATCH, e.g. 0.1.0")
endif()
set(_version "${CMAKE_MATCH_1}")

set(_sha "unknown")
set(_dirty "false")
find_program(_git git)
if(_git)
    execute_process(COMMAND "${_git}" rev-parse --short=7 HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE _head RESULT_VARIABLE _rc
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_rc EQUAL 0 AND _head MATCHES "^[0-9a-f]+$")
        set(_sha "${_head}")
        # Tracked files only: build trees and scratch files are not the build's identity.
        execute_process(COMMAND "${_git}" status --porcelain --untracked-files=no
            WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE _status RESULT_VARIABLE _rc2
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT _rc2 EQUAL 0 OR NOT "${_status}" STREQUAL "")
            set(_dirty "true")
        endif()
    endif()
endif()

set(_string "${_version}+${_sha}")
if(_dirty)
    set(_string "${_string}-dirty")
endif()

set(_text "// Generated by cmake/SpadeVersionGen.cmake on every build; do not edit. Written only when it changes.
#pragma once

#include <string_view>

namespace spade::version {

// The editor's product version (packaging/common/VERSION), the git commit it was built from, and whether tracked files differed.
inline constexpr std::string_view kVersion = \"${_version}\";
inline constexpr std::string_view kGitSha = \"${_sha}\";
inline constexpr bool kDirty = ${_dirty};
// What --version prints and About shows: \"0.1.0+ab12cd3\", with \"-dirty\" appended for a dirty tree.
inline constexpr std::string_view kString = \"${_string}\";

}  // namespace spade::version
")

set(_old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
endif()
if(NOT "${_old}" STREQUAL "${_text}")
    get_filename_component(_dir "${OUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${_dir}")
    file(WRITE "${OUT}" "${_text}")
    message(STATUS "spade_version.hpp: ${_string}")
endif()
