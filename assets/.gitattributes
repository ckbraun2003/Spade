# World and scene files are written by spade::world_to_yaml() and
# spade::scene::scene_to_yaml(), which always write LF, and the editor saves
# them the same way. The root .gitattributes sets `* text=auto`, so without
# these lines a Windows checkout (core.autocrlf=true) would turn them CRLF,
# and a re-save would show as a whole-file diff. tests/golden/.gitattributes
# keeps the golden corpus the same way. eol=lf, not -text: they are read.
*.world.yaml text eol=lf
*.scene.yaml text eol=lf

# Model files (library/drones/) are written by spade::scene::model_to_yaml(),
# which also writes LF. tests/test_library_quad.cpp compares the reference
# quad's against a fresh emission, byte for byte.
*.model.yaml text eol=lf

# Object files (library/primitives/, obstacles/, floors/) are written by
# spade::scene::object_to_yaml(), which writes LF; tests/test_library.cpp
# compares each against a fresh emission, byte for byte. The library's index,
# library.yaml, is hand-written; LF keeps it the same bytes on every checkout.
*.object.yaml text eol=lf
library.yaml text eol=lf
sources.yaml text eol=lf

# Fonts are binary: never convert their line endings.
*.ttf binary
