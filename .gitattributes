# Shell scripts run under sh, which rejects CR line endings. scripts/
# pre-push-guard.sh is installed by copying it to .git/hooks/pre-push, so it
# must check out LF even where core.autocrlf=true.
*.sh text eol=lf

# `git archive` writes the commit it archives into this file ($Format:%H$), so
# a build from an archive, which has no git (the Docker leg, a source tarball),
# still names its commit (cmake/stamp_identity.cmake, core/build_identity.hpp).
cmake/archive_commit.txt export-subst

# A mesh sidecar (world/mesh_file.hpp) is binary: never given CRLF, never
# diffed as text (L7c1; the lead's grant, 2026-10-27).
*.spmesh binary
