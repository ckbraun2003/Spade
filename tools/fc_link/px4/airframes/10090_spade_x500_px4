#!/bin/sh
#
# @name Spade x500 (PX4's own x500 numbers)
#
# @type Quadrotor
#
# The X500 the way PX4's Gazebo model sets it (4001_gz_x500 at v1.17.0, BSD-3-Clause, (c) PX4 Development Team), but for the external MAVLink
# simulator link: no Gazebo (no SIM_GZ_EN, no PX4_SIMULATOR=gz), so px4-rc.simulator starts simulator_mavlink, which listens-for-connect on
# TCP 4560 + instance (Spade is the server). The motor outputs are PWM_MAIN_FUNC 101..104, as 10016_none_iris has them. Spade's PX4-match
# variant flies this so the link can be checked against PX4's own reference before the kit model flies (fc-physics section 4).

. ${R}etc/init.d/rc.mc_defaults

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_PX 0.13
param set-default CA_ROTOR0_PY 0.22
param set-default CA_ROTOR0_KM  0.05

param set-default CA_ROTOR1_PX -0.13
param set-default CA_ROTOR1_PY -0.20
param set-default CA_ROTOR1_KM  0.05

param set-default CA_ROTOR2_PX 0.13
param set-default CA_ROTOR2_PY -0.22
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.13
param set-default CA_ROTOR3_PY 0.20
param set-default CA_ROTOR3_KM -0.05

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

param set-default MPC_THR_HOVER 0.60
# Disabled (PX4's own default): PX4 v1.17.0's rcAndDataLinkCheck.cpp requires a ground station to arm only when NAV_DLL_ACT is above 0, and a headless
# lockstep run has none (the first real run: 'Preflight Fail: No connection to the GCS' while this said 2).
param set-default NAV_DLL_ACT 0
